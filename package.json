{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"const fs=require('fs'); if (fs.existsSync('dist')) { fs.readdirSync('dist').forEach(f => fs.rmSync('dist/' + f, {recursive: true, force: true})); } else { fs.mkdirSync('dist', {recursive: true}); } fs.cpSync('out', 'dist', {recursive: true}); fs.rmSync('out', {recursive: true, force: true});\"",
    "lint": "eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
