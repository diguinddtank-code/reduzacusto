    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lenis": "^1.3.23",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.1.7",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
